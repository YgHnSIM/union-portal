#!/usr/bin/env sh
set -eu

# 1. Fail fast if any sensitive or build-artifact path is tracked in Git
sensitive=$(git ls-files | grep -E '^(data/local/|_raw/|directory/|reports/|_site/|\.env$)' || true)
if [ -n "$sensitive" ]; then
  echo "오류: 민감 데이터 또는 빌드 산출물이 Git에 추적되고 있습니다:"
  echo "$sensitive"
  exit 1
fi

# 2. Run full local verification before pushing
npm run check:local
