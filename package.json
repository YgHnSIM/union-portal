{
  "name": "union-portal",
  "version": "0.1.0",
  "private": true,
  "description": "우체국물류지원단 물류노동조합 종합 관리·공개 포털 시스템",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "union": "tsx src/cli/index.ts",
    "db:migrate": "tsx src/cli/index.ts migrate",
    "export:public": "tsx src/cli/index.ts export-public",
    "audit:privacy": "tsx src/cli/index.ts audit-privacy",
    "build:site": "tsx src/cli/index.ts build-site",
    "build:reports": "tsx src/cli/index.ts build-reports",
    "validate:site": "tsx src/cli/index.ts validate-site",
    "validate:ci": "tsx src/cli/index.ts validate-site --ci",
    "generate:redirects": "tsx src/cli/index.ts generate-redirects",
    "check:local": "npm run typecheck && npm test && npm run audit:privacy && npm run build:site && npm run validate:site",
    "check:ci": "npm run typecheck && npm test && npm run build:site && npm run validate:ci",
    "prepare:hooks": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "markdown-it": "^14.3.0",
    "parse5": "^8.1.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
